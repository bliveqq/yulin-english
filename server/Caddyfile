{
 admin off
}

{$SITE_ADDRESS:localhost} {
 header {
  X-Content-Type-Options nosniff
  Referrer-Policy no-referrer
  -Server
 }
 route {
 @write not method GET HEAD
 respond @write "Method not allowed" 405

 handle /healthz {
  header Content-Type application/json
  header Cache-Control no-store
  respond `{"service":"yulin-english","status":"ok"}` 200
 }
 handle /api/status {
  root * {$SITE_ROOT:/srv/site}
  rewrite * /status.json
  header Cache-Control no-store
  file_server
 }
 handle_path /english/* {
  root * {$LIBRARY_ROOT:/srv/library}
  @manifest path /manifest.json
  handle @manifest {
   header Cache-Control "public, max-age=300"
   file_server
  }
  @file path_regexp asset ^/files/[a-f0-9]{64}\.(doc|docx|pdf|mp3|wav|amr|jpg|jpeg|png|rar|zip)$
  handle @file {
   header Cache-Control "public, max-age=31536000, immutable"
   file_server
  }
  handle {
   respond "Not found" 404
  }
 }
 handle / {
  root * {$SITE_ROOT:/srv/site}
  rewrite * /index.html
  header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; frame-ancestors 'none'"
  file_server
 }
 handle {
  respond "Not found" 404
 }
}
}
